{
  "name": "expense-tracker",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @expense-tracker/api prisma:generate",
    "db:migrate": "pnpm --filter @expense-tracker/api prisma:migrate",
    "db:studio": "pnpm --filter @expense-tracker/api prisma:studio"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3"
  }
}
